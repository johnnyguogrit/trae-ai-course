pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [64, 36, 300, 20]
    content:
      style: "$kicker"
      align: [left, middle]
      wrap: false
      text: HIGHLIGHTS · PYTHON 篇
  - elementId: title
    elementType: text
    bounds: [64, 60, 760, 44]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: 第 1-2 课：Python 起步 + AI 聊天机器人
  - elementId: title-line
    elementType: shape
    bounds: [64, 112, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: l1-badge
    elementType: text
    bounds: [64, 138, 100, 26]
    content:
      fontSize: 14
      color: "$accent"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: 第 1 课
  - elementId: l1-title
    elementType: text
    bounds: [64, 168, 384, 30]
    content:
      fontSize: 19
      color: "$text"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: 你好，Python！
  - elementId: l1-body
    elementType: text
    bounds: [64, 206, 384, 140]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>· 第一次打开 Trae，跑通第一行代码</p>
        <p>· 变量与 print 输出</p>
        <p>· 体验 Tab 键补全：AI 猜你想写什么</p>
  - elementId: l1-out
    elementType: text
    bounds: [64, 352, 384, 26]
    content:
      fontSize: 14
      color: "$cyan"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: ▶ 产出：会说话的自我介绍程序
  - elementId: divider-v
    elementType: shape
    bounds: [478, 138, 1, 310]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: l2-badge
    elementType: text
    bounds: [516, 138, 100, 26]
    content:
      fontSize: 14
      color: "$accent"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: 第 2 课
  - elementId: l2-title
    elementType: text
    bounds: [516, 168, 384, 30]
    content:
      fontSize: 19
      color: "$text"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: AI 聊天机器人
  - elementId: l2-body
    elementType: text
    bounds: [516, 206, 380, 140]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>· input 输入与字符串拼接</p>
        <p>· if 条件判断：机器人"听懂"关键词</p>
        <p>· 用 Chat 区让 AI 帮忙加新功能</p>
  - elementId: l2-out
    elementType: text
    bounds: [516, 352, 380, 26]
    content:
      fontSize: 14
      color: "$cyan"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: ▶ 产出：能问答的命令行聊天机器人
  - elementId: bottom-bar
    elementType: shape
    bounds: [64, 404, 832, 56]
    shapeName: roundRect
    adjustments: [10000]
    fill: {type: solid, color: "$panel"}
  - elementId: bottom-text
    elementType: text
    bounds: [88, 404, 784, 56]
    content:
      fontSize: 14
      color: "$muted"
      fontFamily: 微软雅黑
      lineHeight: 1.5
      align: [left, middle]
      text: |
        <p>教学目标：消除对代码的陌生感 —— 两节课后，每个学生都写过、改过、运行过自己的程序。</p>
  - elementId: pagenum
    elementType: text
    bounds: [860, 500, 64, 20]
    content:
      style: "$small"
      align: [right, middle]
      wrap: false
      text: 07 / 15
