pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [64, 36, 300, 20]
    content:
      style: "$kicker"
      align: [left, middle]
      wrap: false
      text: GOALS
  - elementId: title
    elementType: text
    bounds: [64, 60, 700, 44]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: 两大 AI 技能目标
  - elementId: title-line
    elementType: shape
    bounds: [64, 112, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: s1-panel
    elementType: shape
    bounds: [64, 140, 400, 300]
    shapeName: roundRect
    adjustments: [5000]
    fill: {type: solid, color: "$panel"}
  - elementId: s1-num
    elementType: text
    bounds: [92, 164, 60, 44]
    content:
      fontSize: 34
      color: "$accent"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: "01"
  - elementId: s1-title
    elementType: text
    bounds: [92, 214, 340, 30]
    content:
      fontSize: 21
      color: "$text"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: 代码补全 —— Tab 键的魔法
  - elementId: s1-body
    elementType: text
    bounds: [92, 254, 344, 160]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>· 写函数名，AI 补全函数体</p>
        <p>· 写注释，AI 把注释变成代码</p>
        <p>· 报错时让 AI 解释并修复</p>
        <p style="margin-top:10px"><span style="color:$cyan">关键能力</span>：读懂 AI 的建议，判断对不对、该不该接受。</p>
  - elementId: s2-panel
    elementType: shape
    bounds: [496, 140, 400, 300]
    shapeName: roundRect
    adjustments: [5000]
    fill: {type: solid, color: "$panel"}
  - elementId: s2-num
    elementType: text
    bounds: [524, 164, 60, 44]
    content:
      fontSize: 34
      color: "$cyan"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: "02"
  - elementId: s2-title
    elementType: text
    bounds: [524, 214, 344, 30]
    content:
      fontSize: 21
      color: "$text"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: Vibe Coding —— 自然语言变程序
  - elementId: s2-body
    elementType: text
    bounds: [524, 254, 344, 160]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>· 用中文描述"我想要什么"</p>
        <p>· AI 生成完整网页或小游戏</p>
        <p>· 不满意就继续对话迭代</p>
        <p style="margin-top:10px"><span style="color:$cyan">关键能力</span>：把模糊想法拆成清晰需求，写好提示词。</p>
  - elementId: bottom-note
    elementType: text
    bounds: [64, 458, 832, 26]
    content:
      fontSize: 14
      color: "$muted"
      fontFamily: 微软雅黑
      align: [center, middle]
      wrap: false
      text: 补全用于"写的时候"，Vibe Coding 用于"想的时候" —— 两项技能贯穿全部 8 次课
  - elementId: pagenum
    elementType: text
    bounds: [860, 500, 64, 20]
    content:
      style: "$small"
      align: [right, middle]
      wrap: false
      text: 04 / 15
