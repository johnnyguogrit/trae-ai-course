pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [64, 36, 300, 20]
    content:
      style: "$kicker"
      align: [left, middle]
      wrap: false
      text: HIGHLIGHTS · 网页篇
  - elementId: title
    elementType: text
    bounds: [64, 60, 760, 44]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: 第 5-6 课：个人主页 + 交互页面
  - elementId: title-line
    elementType: shape
    bounds: [64, 112, 832, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: l5-badge
    elementType: text
    bounds: [64, 138, 100, 26]
    content:
      fontSize: 14
      color: "$accent"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: 第 5 课
  - elementId: l5-title
    elementType: text
    bounds: [64, 168, 384, 30]
    content:
      fontSize: 19
      color: "$text"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: 我的个人主页（HTML）
  - elementId: l5-body
    elementType: text
    bounds: [64, 206, 384, 140]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>· 标签与网页骨架：标题、段落、图片</p>
        <p>· 简单样式：颜色、字体、排版</p>
        <p>· AI 生成页面框架，学生改内容</p>
  - elementId: l5-out
    elementType: text
    bounds: [64, 352, 384, 26]
    content:
      fontSize: 14
      color: "$cyan"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: ▶ 产出：可在浏览器打开的个人主页
  - elementId: divider-v
    elementType: shape
    bounds: [478, 138, 1, 310]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: l6-badge
    elementType: text
    bounds: [516, 138, 100, 26]
    content:
      fontSize: 14
      color: "$accent"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: 第 6 课
  - elementId: l6-title
    elementType: text
    bounds: [516, 168, 384, 30]
    content:
      fontSize: 19
      color: "$text"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: 会动的交互页面（JavaScript）
  - elementId: l6-body
    elementType: text
    bounds: [516, 206, 380, 140]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>· 按钮与点击事件</p>
        <p>· 用 JS 改文字、改颜色、做计数器</p>
        <p>· 把想法描述给 AI，生成交互效果</p>
  - elementId: l6-out
    elementType: text
    bounds: [516, 352, 380, 26]
    content:
      fontSize: 14
      color: "$cyan"
      bold: true
      fontFamily: 微软雅黑
      align: [left, middle]
      wrap: false
      text: ▶ 产出：带按钮和动效的交互页面
  - elementId: bottom-bar
    elementType: shape
    bounds: [64, 404, 832, 56]
    shapeName: roundRect
    adjustments: [10000]
    fill: {type: solid, color: "$panel"}
  - elementId: bottom-text
    elementType: text
    bounds: [88, 404, 784, 56]
    content:
      fontSize: 14
      color: "$muted"
      fontFamily: 微软雅黑
      lineHeight: 1.5
      align: [left, middle]
      text: |
        <p>从命令行走进浏览器：作品变得"看得见、摸得着"，学生可以当场把链接分享给家人。</p>
  - elementId: pagenum
    elementType: text
    bounds: [860, 500, 64, 20]
    content:
      style: "$small"
      align: [right, middle]
      wrap: false
      text: 09 / 15
